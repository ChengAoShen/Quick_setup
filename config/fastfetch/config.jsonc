{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
    "display": {
        "key": {
            "width": 10
        },
        "size": {
            "binaryPrefix": "jedec"
        },
        "separator": ""
    },
    "logo": {
        "type": "kitty-direct",
        "source": "~/.config/fastfetch/marin.png",
        "width": 20,
        "height": 10
    },
    "modules": [
        "break",
        {
            "type": "host",
            "key": "Host",
            "keyColor": "#CDA843",
            "format": "{name}"
        },
        {
            "type": "os",
            "key": "OS",
            "keyColor": "#555B3C",
            "format": "{name}"
        },
        {
            "type": "shell",
            "key": "Shell",
            "keyColor": "#984A32",
            "format": "{pretty-name}"
        },
        {
            "type": "wm",
            "key": "WM",
            "keyColor": "#CDA843",
            "format": "{pretty-name}"
        },
        {
            "type": "packages",
            "key": "Pkgs",
            "keyColor": "#555B3C"
        },
        {
            "type": "memory",
            "key": "RAM",
            "keyColor": "#984A32",
            "format": "{used} / {total}"
        },
        {
            "type": "disk",
            "key": "Disk",
            "keyColor": "#CDA843",
            "folders": ["/"],
            "format": "{size-used} / {size-total}"
        },
        "break",
        {
            "type": "custom",
            "format": "\u001b[38;2;205;168;67m󰮯 \u001b[38;2;85;91;60m󰊠 \u001b[38;2;152;74;50m󰊠 \u001b[38;2;205;168;67m󰊠 \u001b[38;2;85;91;60m󰊠 \u001b[38;2;152;74;50m󰊠 \u001b[38;2;205;168;67m󰊠 \u001b[38;2;85;91;60m󰊠\u001b[0m"
        }
    ]
}
